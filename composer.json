{
    "name": "drupal/varbase_ai_media_base",
    "description": "Generate images and SVGs with AI from the Media Library on Varbase 11, with the AI Media module: an \"Upload | Generate with AI\" switch inside the Image and SVG Image tabs, saving into those media types, with the permission granted to the editorial roles. No custom PHP or shell code.",
    "type": "drupal-recipe",
    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "Drupal AI",
        "AI Media",
        "media library",
        "image generation",
        "SVG"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/varbase_ai_media_base",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/varbase_ai_media_base",
        "source": "https://git.drupalcode.org/project/varbase_ai_media_base"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "drupal/ai": "^1.5",
        "drupal/ai_media": "^1.0.0-rc3",
        "drupal/core": "^11.4",
        "drupal/svg_image": "^3.2.5"
    }
}
